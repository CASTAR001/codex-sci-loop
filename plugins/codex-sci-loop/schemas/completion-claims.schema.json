{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumiforge.invalid/schemas/sci-loop-completion-claims-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "claims"],
  "properties": {
    "schema": {"const": "sci-loop-completion-claims-v1"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "criterion_ids"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "statement": {"type": "string", "minLength": 1},
          "criterion_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/id"}
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"}
  }
}
