{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumiforge.invalid/schemas/sci-loop-runtime-certification-identity-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "state", "runtime", "runtime_version", "plugin_version",
    "adapter_id", "certificate_sha256", "probe_sha256",
    "runtime_artifact_sha256", "plugin_tree_sha256",
    "receipt_authority_public_key_sha256", "receipt_signature_algorithm"
  ],
  "properties": {
    "schema": {"const": "sci-loop-runtime-certification-identity-v1"},
    "state": {"const": "CERTIFIED"},
    "runtime": {"const": "codex"},
    "runtime_version": {"type": "string", "minLength": 1},
    "plugin_version": {"type": "string", "minLength": 1},
    "adapter_id": {"type": "string", "minLength": 1},
    "certificate_sha256": {"$ref": "#/$defs/sha256"},
    "probe_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "plugin_tree_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_authority_public_key_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_signature_algorithm": {"const": "ed25519"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
