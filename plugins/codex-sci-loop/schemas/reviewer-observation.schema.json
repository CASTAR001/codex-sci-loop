{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumiforge.invalid/schemas/sci-loop-reviewer-observation-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "reviewer_thread_id", "reviewer_type", "snapshot_sha256",
    "isolation", "parent_history_shared", "started", "stopped"
  ],
  "properties": {
    "schema": {"const": "sci-loop-reviewer-observation-v1"},
    "reviewer_thread_id": {"$ref": "#/$defs/opaqueId"},
    "reviewer_type": {"const": "independent_completion_auditor"},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "isolation": {"const": "clean-room-read-only"},
    "parent_history_shared": {"const": false},
    "started": {"const": true},
    "stopped": {"const": true}
  },
  "$defs": {
    "opaqueId": {"type": "string", "pattern": "^[^\\u0000-\\u001F\\u007F]{1,256}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
