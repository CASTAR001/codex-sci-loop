{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumiforge.invalid/schemas/sci-loop-runtime-probe-v1.json",
  "title": "sci-loop runtime behavior probe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runtime",
    "runtime_version",
    "plugin_version",
    "adapter_id",
    "plugin_tree_sha256",
    "runtime_artifact_sha256",
    "behavior_evidence_sha256",
    "capabilities",
    "preconditions",
    "observed_runtime_capabilities"
  ],
  "properties": {
    "schema": {
      "const": "sci-loop-runtime-probe-v1"
    },
    "runtime": {
      "const": "codex"
    },
    "runtime_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "plugin_version": {
      "type": "string",
      "minLength": 1
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "plugin_tree_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "behavior_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "observed_runtime_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
