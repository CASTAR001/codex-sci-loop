{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumiforge.invalid/schemas/sci-loop-independent-audit-outcome-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "snapshot_sha256", "reviewer_thread_id", "requirement_results",
    "claim_results", "overall", "blocked_requires_user", "summary"
  ],
  "properties": {
    "schema": {"const": "sci-loop-independent-audit-outcome-v1"},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer_thread_id": {"$ref": "#/$defs/opaqueId"},
    "requirement_results": {"type": "array", "items": {"$ref": "#/$defs/result"}},
    "claim_results": {"type": "array", "items": {"$ref": "#/$defs/result"}},
    "overall": {"enum": ["PASS", "FAIL", "UNVERIFIED", "BLOCKED"]},
    "blocked_requires_user": {"type": "boolean"},
    "summary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"},
    "opaqueId": {"type": "string", "pattern": "^[^\\u0000-\\u001F\\u007F]{1,256}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome", "evidence_refs", "rationale"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "outcome": {"enum": ["PASS", "FAIL", "UNVERIFIED", "BLOCKED"]},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
