{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumiforge.invalid/schemas/sci-loop-pending-request-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "envelope", "project_root_sha256", "session_id_sha256", "turn_id_sha256"
  ],
  "properties": {
    "schema": {"const": "sci-loop-pending-request-v1"},
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "request_id", "original_request", "revisions"],
      "properties": {
        "schema": {"const": "sci-loop-request-envelope-v1"},
        "request_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"},
        "original_request": {"type": "string", "minLength": 1},
        "revisions": {"type": "array", "maxItems": 0}
      }
    },
    "project_root_sha256": {"$ref": "#/$defs/sha256"},
    "session_id_sha256": {"$ref": "#/$defs/sha256"},
    "turn_id_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
