{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumiforge.invalid/schemas/sci-loop-audit-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "issued_by", "snapshot_sha256", "audit_outcome_sha256",
    "reviewer_transcript_sha256", "reviewer_observation_sha256",
    "runtime_certification_sha256", "receipt_authority_public_key_sha256",
    "receipt_signature_algorithm", "reviewer_thread_id", "verdict"
  ],
  "properties": {
    "schema": {"const": "sci-loop-audit-receipt-v1"},
    "issued_by": {"const": "lumiforge-independent-audit-host-v1"},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "audit_outcome_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer_transcript_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer_observation_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_certification_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_authority_public_key_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_signature_algorithm": {"const": "ed25519"},
    "reviewer_thread_id": {"$ref": "#/$defs/opaqueId"},
    "verdict": {"enum": ["PASS", "FAIL", "UNVERIFIED", "BLOCKED"]}
  },
  "$defs": {
    "opaqueId": {"type": "string", "pattern": "^[^\\u0000-\\u001F\\u007F]{1,256}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
