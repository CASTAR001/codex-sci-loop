{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumiforge.invalid/schemas/sci-loop-audit-snapshot-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "phase_id", "phase_title", "phase_objective", "request",
    "acceptance_criteria", "completion_claims", "source_hashes", "workspace",
    "verification", "evidence_manifest", "runtime_certification"
  ],
  "properties": {
    "schema": {"const": "sci-loop-audit-snapshot-v1"},
    "phase_id": {"type": "string", "minLength": 1},
    "phase_title": {"type": "string", "minLength": 1},
    "phase_objective": {"type": "string", "minLength": 1},
    "request": {"type": "object"},
    "acceptance_criteria": {"type": "object"},
    "completion_claims": {"type": "object"},
    "source_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_envelope_sha256", "acceptance_criteria_sha256",
        "completion_claims_sha256", "runtime_certification_sha256"
      ],
      "properties": {
        "request_envelope_sha256": {"$ref": "#/$defs/sha256"},
        "acceptance_criteria_sha256": {"$ref": "#/$defs/sha256"},
        "completion_claims_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_certification_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories"],
      "properties": {
        "repositories": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "log_sha256", "log_bytes"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "exit_code": {"const": 0},
        "log_sha256": {"$ref": "#/$defs/sha256"},
        "log_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "evidence_manifest": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sha256", "bytes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "runtime_certification": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
